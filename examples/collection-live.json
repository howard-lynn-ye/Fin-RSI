{
  "watches": [
    {
      "id": "live-fed-news",
      "source": "rss",
      "target": "https://www.federalreserve.gov/feeds/press_all.xml",
      "interval_seconds": 300
    },
    {
      "id": "live-michigan-sentiment",
      "source": "umich",
      "target": "consumer_sentiment",
      "interval_seconds": 3600
    },
    {
      "id": "live-cftc-sp500",
      "source": "cftc",
      "target": "13874A",
      "interval_seconds": 3600,
      "options": {"weeks": 4}
    },
    {
      "id": "live-house-pelosi",
      "source": "house",
      "target": "Pelosi",
      "interval_seconds": 1800,
      "options": {"year": "current", "first_name": "Nancy", "lookback_days": 90,
                  "newest_first": true, "max_filings": 2}
    }
  ]
}
